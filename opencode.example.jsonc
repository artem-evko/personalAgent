{
  "$schema": "https://opencode.ai/config.json",
  "model": "rsiai/claude-sonnet-5-5",
  "instructions": [
    "AGENTS.md",
    ".opencode/memory/project_architecture.md",
    ".opencode/memory/active_handoff.md"
  ],
  "agents": {
    "build": {
      "steps": 100
    },
    "explore": {
      "steps": 20,
      "description": "Быстрый субагент-разведчик кода (отчет до 350 слов)",
      "system": "Ты быстрый разведчик кодовой базы. Ищи через grep/glob и читай только нужные строки. Возвращай СЖАТЫЙ технический отчет (МАКСИМУМ 350 СЛОВ): точные пути к файлам, номера строк, сигнатуры и причины багов. Не вставляй файлы целиком."
    },
    // Заменяет small_model: Haiku в rsiai нет (model_not_found)
    "title": {
      "model": "rsiai/claude-sonnet-5-5"
    }
  },
  "providers": {
    // Токен группы claude (0.05x)
    "rsiai": {
      "name": "RSI · Claude (0.05x)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://www.rsiai.net/v1",
        "apiKey": "{file:~/.secrets/rsiai-key}"
      },
      "compatibility": { "cacheFormat": "anthropic" },
      "models": {
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5 (RSI)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 200000, "output": 32000 },
          "cost": { "input": 0.2, "output": 1, "cache": { "read": 0.01 } }
        },
        "claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5 (RSI)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 200000, "output": 32000 },
          "cost": { "input": 0.1, "output": 0.5, "cache": { "read": 0.005 } }
        },
        "claude-opus-5": {
          "name": "Claude Opus 5 (RSI)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 200000, "output": 32000 },
          "cost": { "input": 0.25, "output": 1.25, "cache": { "read": 0.025 } }
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8 (RSI)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 200000, "output": 32000 },
          "cost": { "input": 0.25, "output": 1.25, "cache": { "read": 0.025 } }
        }
      }
    },
    // Токен группы gpt (0.07x), ключ в ~/.secrets/rsiai-gpt-key
    "rsiai-gpt": {
      "name": "RSI · GPT (0.07x)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://www.rsiai.net/v1",
        "apiKey": "{file:~/.secrets/rsiai-gpt-key}"
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra (RSI)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 200000, "output": 32000 },
          "cost": { "input": 0.7, "output": 3.5, "cache": { "read": 0.07 } }
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol (RSI)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 200000, "output": 32000 },
          "cost": { "input": 0.14, "output": 0.7, "cache": { "read": 0.007 } }
        },
        "gpt-6-sol": {
          "name": "GPT-6 Sol (RSI)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 200000, "output": 32000 },
          "cost": { "input": 0.14, "output": 0.7, "cache": { "read": 0.014 } }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra (RSI)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 200000, "output": 32000 },
          "cost": { "input": 0.14, "output": 0.84, "cache": { "read": 0.014 } }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        // npx.ps1 заблокирован ExecutionPolicy, поэтому npx запускается через node
        "command": [
          "node",
          "C:\\Program Files\\nodejs\\node_modules\\npm\\bin\\npx-cli.js",
          "-y",
          "@playwright/mcp@0.0.84",
          "--browser",
          "chrome",
          "--caps",
          "vision,pdf",
          // нужно дизайнерам, чтобы открывать свои локальные файлы через file://
          "--allow-unrestricted-file-access"
        ],
        "timeout": { "startup": 120000 }
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "Remove-Item *", "effect": "ask" },
    { "action": "shell", "resource": "ri *", "effect": "ask" },
    { "action": "shell", "resource": "rd *", "effect": "ask" },
    { "action": "shell", "resource": "del *", "effect": "ask" },
    { "action": "shell", "resource": "erase *", "effect": "ask" },
    { "action": "shell", "resource": "cmd *", "effect": "ask" }
  ],
  "compaction": {
    "auto": true
  }
}
